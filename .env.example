# Kopiera till .env.local och fyll i egna värden.
# Samma värden (och BLOB_READ_WRITE_TOKEN nedan) läggs in under Environment Variables på Vercel.

# Sajtlösenordet: det som familj och vänner skriver in för att komma in på sajten.
# Saknas det, eller nyckeln nedan, är sajten stängd för alla (och bygget på Vercel stoppas).
SITE_PASSWORD=

# Lång slumpad sträng som signerar sajtkakan (skapas som ADMIN_SESSION_SECRET nedan).
# Byts den loggas alla ut.
SITE_SESSION_SECRET=

# Lösenordet till /admin (MUPP-003). Saknas det, eller nyckeln nedan, är admin stängd för alla
# (och bygget på Vercel stoppas).
ADMIN_PASSWORD=

# Lång slumpad sträng som signerar inloggningscookien. Skapa en med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Hemligheten som jobbet "Secret Santa-mejl" (GitHub Actions, MUPP-042) skickar för att få mejla om ändrade önskelistor.
# Minst 32 tecken; samma värde läggs som secret SANTA_JOB_SECRET i GitHub och i Vercel (Production). Saknas den är jobbet stängt.
SANTA_JOB_SECRET=

# Bara på Vercel: nyckeln till det privata Blob-lagret där barnens bilder ligger. Sätt den INTE i
# .env.local: utan den sparas bilder i en mapp bredvid databasen (PICTURES_DIR) och inget rör det riktiga lagret.
# BLOB_READ_WRITE_TOKEN=

# Nyckeln till Resend, som skickar mejlen (TECH-020). Sätts på Vercel; i .env.local bara för testskriptet nedan,
# men då skickar även npm run dev riktiga mejl. Utan nyckeln skickas inget riktigt mejl (lokalt hamnar mejlen i utkorgen). Testa leveransen med: node --env-file=.env.local scripts/send-test-mail.mjs din@adress.se
# RESEND_API_KEY=…

# Bara på Vercel (och i .env.turso för npm run db:turso), INTE i .env.local,
# annars arbetar du lokalt mot den riktiga databasen.
# TURSO_DATABASE_URL=libsql://muppbarnen-<ditt-konto>.turso.io
# TURSO_AUTH_TOKEN=
