# Kopiera till .env.local och fyll i egna värden.
# Samma fyra värden läggs in under Environment Variables på Vercel.

# Sajtlösenordet: det som familj och vänner skriver in för att komma in på sajten.
# Saknas det, eller nyckeln nedan, är sajten stängd för alla (och bygget på Vercel stoppas).
SITE_PASSWORD=

# Lång slumpad sträng som signerar sajtkakan (skapas som ADMIN_SESSION_SECRET nedan).
# Byts den loggas alla ut.
SITE_SESSION_SECRET=

# Lösenordet till /admin
ADMIN_PASSWORD=

# Lång slumpad sträng som signerar inloggningscookien. Skapa en med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Bara på Vercel (och i .env.turso för npm run db:turso), INTE i .env.local,
# annars arbetar du lokalt mot den riktiga databasen.
# TURSO_DATABASE_URL=libsql://muppbarnen-<ditt-konto>.turso.io
# TURSO_AUTH_TOKEN=
