# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite-databasen (skapas från db/schema.sql och db/seed.sql)
/db/*.db*
/db/backups/
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# designverktygens arbetsfiler (den godkända designtavlan ligger i specs/)
/.impeccable/
/.taste-skill/

# barnens bilder: ligger lokalt och i Vercel Blob, aldrig i Git (repot är publikt)
/pictures/

# personliga Claude Code-inställningar
/.claude/settings.local.json

# sparad inloggning med sajtlösenordet för testerna
/playwright/.auth/
